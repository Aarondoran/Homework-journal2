rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can only read or write documents that live
    // under their own users/{uid} path. No one can access another
    // user's homework or notes, even if they know the UID.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
